{
  "name": "dsh-region-edit",
  "version": "0.5.2",
  "description": "DeepSeek Harness 桌面端点选与圈选修改：源码定位、前后预览与安全回滚",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/a961282799-crypto/dsh-region-edit#readme",
  "repository": { "type": "git", "url": "git+https://github.com/a961282799-crypto/dsh-region-edit.git" },
  "bugs": { "url": "https://github.com/a961282799-crypto/dsh-region-edit/issues" },
  "main": "./dist/index.js",
  "exports": { ".": "./dist/index.js", "./client": "./dist/client.js", "./package.json": "./package.json" },
  "files": ["dist", "cordis.patch.yml", "README.md", "VALIDATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "keywords": ["dsh-plugin", "deepseek-harness", "desktop", "region-edit"],
  "engines": { "node": ">=22.18" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "peerDependencies": { "@deepseek-ai/dsh": "0.2.1-rc.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.5", "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh": { "optional": true }, "@deepseek-ai/dsh-llm": { "optional": true }, "@deepseek-ai/dsh-typert-protocol": { "optional": true } },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/core.test.ts tests/history.test.ts",
    "test:interaction": "node tests/interaction.mjs",
    "test:host": "node scripts/host-check.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:interaction && npm run test:host",
    "pack:plugin": "npm run check && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2"
  }
}
